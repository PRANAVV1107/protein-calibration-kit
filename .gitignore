# ---------------------------------------------------------------------------
# Known-bad artifacts, kept on disk so the record of what went wrong stays
# auditable, but never published. QUARANTINE/README.md states this intent
# explicitly. A rewrite of this file on 2026-10-20 dropped the rule and staged
# five files, including a CSV of 100 random amino-acid strings labelled as
# IL-7Ra designs -- which, published without context, reads as fabricated data.
# ---------------------------------------------------------------------------
QUARANTINE/

# ---------------------------------------------------------------------------
# results/ holds ~6,700 ColabFold predictions: PDBs, PAE matrices, MSAs,
# mmseqs2 environment dumps, MD trajectories. Tens of thousands of files and
# many GB, all regenerable from scripts/ plus the tracked manifests.
#
# Blacklisting failed -- payloads appear at many depths under many directory
# names. This whitelists instead: ignore everything under results/, then
# re-admit only the small files that constitute the record.
# ---------------------------------------------------------------------------
results/**

# directories must be re-admitted for the patterns below to be reachable
!results/**/

# the record: what was run, and the extracted numbers every analysis reads
!results/**/manifest.csv
!results/**/to_fold.fasta
!results/**/state.json
!results/**/REGISTRATION.md
!results/**/WHY_VOID.md
!results/*.csv
!results/*.txt
!results/*.log
!results/**/*_results.csv
!results/**/*_summary.csv
!results/variance_study/**/*.csv
!results/rescore/*.csv

# Raw per-design score JSONs are deliberately NOT tracked. There are ~6,700 of
# them; the numbers they contain are in the analysis CSVs above, and the files
# themselves are regenerable. Re-folding is documented in README.md.

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
