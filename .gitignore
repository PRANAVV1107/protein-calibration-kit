# Fold outputs -- large, regenerable, and not useful in version control.
# Ignore everything under results/ by default; whitelist summaries explicitly below.
results/**
!results/.gitkeep
!results/**/ranked.csv
!results/**/variance_results.csv
!results/**/per_backbone_summary.csv

# Raw structures and prediction dumps anywhere
*.pdb
!benchmark/**/*.pdb
*.a3m
*.pkl

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# Large files
*.tar.gz
*.zip
